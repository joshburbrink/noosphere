[Unit]
Description=Noosphere radio monitor  -  squelch-aware capture and transcription
After=network.target

[Service]
Type=simple
ExecStart=/opt/noosphere-whisper/bin/python3 /usr/local/bin/noosphere-radio-transcribe.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
