[Unit]
Description=Noosphere Meshtastic bridge (#90)
After=network.target
# Note: ConditionPathExists removed — USB enumeration is racy at boot and
# systemd does not retry Condition-skipped units. The companion .path unit
# (noosphere-meshtastic.path) triggers this service when /dev/ttyUSB0 appears.

[Service]
Type=simple
EnvironmentFile=-/etc/noosphere/meshtastic.conf
ExecStart=/opt/noosphere-meshtastic/bin/python3 /usr/local/bin/noosphere-meshtastic.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
